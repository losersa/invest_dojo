# ═══════════════════════════════════════════════════════════════════
# InvestDojo · 基础设施 · 环境变量模板
# ═══════════════════════════════════════════════════════════════════
#
# 首次运行 ./scripts/up.sh（或 .\scripts\up.ps1）时会：
#   - 把本文件复制为 .env
#   - 自动生成 POSTGRES_PASSWORD / AUTH_JWT_SECRET
#
# 你只需要关心：POSTGRES_PASSWORD / AUTH_JWT_SECRET（自动生成的就够用）
# ═══════════════════════════════════════════════════════════════════

# ── Postgres ────────────────────────────────────────────────────
POSTGRES_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
POSTGRES_PORT=5432

# ── 自建鉴权（common/auth.py + data-svc）─────────────────────────
# JWT 签名密钥；生产务必用强随机值（up 脚本会自动生成）
AUTH_JWT_SECRET=<CHANGE_ME_AT_LEAST_32_BYTES>

# ── Redis ───────────────────────────────────────────────────────
REDIS_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# ── MinIO ───────────────────────────────────────────────────────
MINIO_ROOT_USER=investdojo
MINIO_ROOT_PASSWORD=investdojo_dev_only

# ── 数据目录（默认 ./data，Windows 建议改到 E 盘）─────────────────
# Windows 示例：DATA_DIR=E:/investdojo/data
DATA_DIR=./data
